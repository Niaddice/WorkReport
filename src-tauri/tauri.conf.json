{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkReport",
  "version": "0.1.3",
  "identifier": "com.workreport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkReport",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#f8fafd"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
